{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOP Server Manager",
  "version": "2.0.3",
  "identifier": "com.topserver.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TOP Server Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TOP Server Manager",
    "copyright": "© 2026 TOP Server Manager",
    "category": "DeveloperTool",
    "shortDescription": "Run and host web & game servers on Windows",
    "longDescription": "TOP Server Manager Ultimate manages PHP, Node.js, Java/Minecraft and custom servers, databases and public hosting (Cloudflare Tunnel, ngrok, playit.gg, FRP, Tailscale, Direct IP) from one window.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Thai"],
        "customLanguageFiles": { "Thai": "nsis/Thai.nsh" },
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "TOP Server Manager",
        "compression": "lzma"
      }
    }
  }
}
